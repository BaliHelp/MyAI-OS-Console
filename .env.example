# ════════════════════════════════════════════════════════════════════════════
# MyAI OS Console — Environment Variables Template
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# ════════════════════════════════════════════════════════════════════════════

# ── Supabase (share with other ecosystem apps, gateway_console schema is isolated) ──
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# Optional overrides — only set these if the Gateway needs to point at a DIFFERENT Supabase
# project than the NEXT_PUBLIC_SUPABASE_* pair above (e.g. local dev against a separate project
# without touching the shared vars other ecosystem apps also read). Falls back to
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY when unset
# (lib/supabase.ts, lib/supabase-client.ts) — leave unset in the normal case.
# GATEWAY_SUPABASE_URL=https://<project-ref>.supabase.co
# GATEWAY_SUPABASE_ANON_KEY=<your-supabase-anon-key>
# GATEWAY_SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# Use AIzaSy... key from aistudio.google.com (NOT AQ.Ab8... OAuth token — it expires in 1h)
GEMINI_API_KEY=AIzaSy<your-gemini-api-key>

# ── Numbered key pools (auto-imported into gw_provider_keys on startup, lib/migrate.ts) ──
# Add as many as you have, up to the max below — each becomes a separate row in the
# rotation pool for that provider (lib/gemini-key-pool.ts for Gemini's internal multi-key
# rotation; the generic priority/LRU candidate sort in the routing loop for the rest).
# Gemini: GEMINI_API_KEY1 .. GEMINI_API_KEY6
# GPT:    OPENAI_API_KEY1 .. OPENAI_API_KEY5  (KEY1 and KEY5 seed with higher priority)
# Claude, Grok, Deepseek: *_API_KEY1 only (no multi-key pool for these yet)
OPENAI_API_KEY1=sk-proj-<your-openai-api-key-1>
CLAUDE_API_KEY1=sk-ant-sid01-<your-claude-api-key-1>
GROK_API_KEY1=xai-<your-grok-api-key-1>
DEEPSEEK_API_KEY1=sk-<your-deepseek-api-key-1>
# GEMINI_API_KEY2=AIzaSy<your-gemini-api-key-2>
# OPENAI_API_KEY2=sk-proj-<your-openai-api-key-2>

# Bare (unnumbered) fallbacks — read directly by the routing loop's env-fallback path when
# no active key exists yet in gw_provider_keys for that provider (skipped once you have DB
# keys). Distinct from the numbered *_KEY1 vars above, which only affect startup auto-import.
# OPENAI_API_KEY=sk-proj-<bare fallback>
# CLAUDE_API_KEY=sk-ant-sid01-<bare fallback>
# GROK_API_KEY=xai-<bare fallback>
# DEEPSEEK_API_KEY=sk-<bare fallback>

# ── Auth & Session Security ────────────────────────────────────────────────────
# bcrypt hash of your admin password. Generate with: npm run generate-hash
# Example: bcryptjs.hashSync("your_password", 10)
ADMIN_PASSWORD_HASH=<your-bcrypt-hash>

# Admin email address allowed to login
ADMIN_EMAIL=rimbanusaonline@gmail.com

# Secret for signing JWT session cookies (generate: openssl rand -hex 32)
SESSION_SECRET=<64-char-hex-string>

# Required to call POST /api/auth/forgot-password. That endpoint is public (no session
# cookie needed) since its whole purpose is recovering a lost password, so this secret is
# the only thing standing between "I forgot my password" and anyone on the internet who
# knows the admin email. Never expose this to a browser. Generate: openssl rand -base64 32
PASSWORD_RESET_SECRET=<random-secret-known-only-to-you>

# ── Provider Key Encryption ────────────────────────────────────────────────────
# AES-256 master key for encrypting upstream provider API keys in DB
# Must be exactly 32 characters
PROVIDER_KEY_ENCRYPTION_SECRET=<32-char-random-string>

# ── App URL ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Boss Bayu Admin Recognition Passphrases ──────────────────────────────────
ADMIN_PASSPHRASE_IDENTITY=boss_bayu_master_passphrase_identity
ADMIN_PASSPHRASE_CONFIRM=boss_bayu_confirm_action_key_99
